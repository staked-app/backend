# Copy to .env and fill in. `.env` is gitignored.

# --- SuperTokens core (docker-compose.yml) ---
ST_DB_PASSWORD=change-me
ST_API_KEY=change-me-long-random-string
SUPERTOKENS_URI=http://localhost:3567

# --- This API ---
# Android emulator reaches the host as 10.0.2.2, so the app uses http://10.0.2.2:8000.
API_DOMAIN=http://localhost:8000
WEBSITE_DOMAIN=http://localhost:2000
CORS_ORIGINS=http://localhost:3000,http://localhost:2000

# --- Google OAuth ---
# Web application client ID from Google Cloud Console (APIs & Services > Credentials).
# The Flutter app must be started with the SAME value as GOOGLE_SERVER_CLIENT_ID so
# the ID token's audience matches. Android/iOS client IDs are created separately in
# the same console (package name + SHA-1 / bundle ID) and are not used here.
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# Only needed if you later add a browser redirect flow.
GOOGLE_CLIENT_SECRET=
